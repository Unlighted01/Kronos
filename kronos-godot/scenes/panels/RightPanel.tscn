[node name="Card" type="PanelContainer" parent="DTRModal/Center"]
custom_minimum_size = Vector2(180, 220)
layout_mode = 2

[node name="VBox" type="VBoxContainer" parent="DTRModal/Center/Card"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.960784, 0.619608, 0.0392157, 1)
text = "EDIT DTR ENTRY"
horizontal_alignment = 1

[node name="TaskLbl" type="Label" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 7
text = "TASK NAME"

[node name="TaskInput" type="LineEdit" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
placeholder_text = "e.g. Debugging"

[node name="CategoryLbl" type="Label" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 7
text = "CATEGORY"

[node name="CategoryInput" type="LineEdit" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
placeholder_text = "e.g. work"

[node name="HBox" type="HBoxContainer" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="StartVBox" type="VBoxContainer" parent="DTRModal/Center/Card/VBox/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="StartLbl" type="Label" parent="DTRModal/Center/Card/VBox/HBox/StartVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 7
text = "START TIME (HH:MM)"

[node name="StartInput" type="LineEdit" parent="DTRModal/Center/Card/VBox/HBox/StartVBox"]
layout_mode = 2
placeholder_text = "09:00"

[node name="EndVBox" type="VBoxContainer" parent="DTRModal/Center/Card/VBox/HBox"]
layout_mode = 2
size_flags_horizontal = 3

[node name="EndLbl" type="Label" parent="DTRModal/Center/Card/VBox/HBox/EndVBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 7
text = "END TIME (HH:MM)"

[node name="EndInput" type="LineEdit" parent="DTRModal/Center/Card/VBox/HBox/EndVBox"]
layout_mode = 2
placeholder_text = "09:25"

[node name="DateLbl" type="Label" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 7
text = "DATE (YYYY-MM-DD)"

[node name="DateInput" type="LineEdit" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
placeholder_text = "2026-08-18"

[node name="Spacer" type="Control" parent="DTRModal/Center/Card/VBox"]
custom_minimum_size = Vector2(0, 4)
layout_mode = 2

[node name="SaveBtn" type="Button" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.309804, 0.819608, 0.909804, 1)
text = "SAVE ENTRY"

[node name="DeleteBtn" type="Button" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.301961, 0.301961, 1)
text = "DELETE ENTRY"

[node name="CancelBtn" type="Button" parent="DTRModal/Center/Card/VBox"]
layout_mode = 2
text = "CANCEL"
